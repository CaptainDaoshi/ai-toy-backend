# DeepSeek key: kept on the server only. Never put it in firmware or a mobile app.
DEEPSEEK_API_KEY=
# Paste a newly generated key in your local .env file, not in this example file.
# DEEPSEEK_API_TOKEN is also accepted, but do not set both.
DEEPSEEK_MODEL=deepseek-v4-flash
# Do not append /v1: the chat endpoint is /chat/completions.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: if this computer/server needs an outbound proxy to reach DeepSeek.
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=127.0.0.1,localhost

# Optional: protects toy-facing endpoints. Leave empty during local development.
TOY_API_TOKEN=

# Required server-only master secret for deriving per-device HMAC tokens (32+ random characters).
DEVICE_AUTH_SECRET=

# Comma-separated browser origins allowed to call the API during local frontend development.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Hippocampal-style memory: a small recent working set plus a bounded long-term summary.
WORKING_MEMORY_MESSAGES=8
MEMORY_CONSOLIDATION_BATCH_MESSAGES=12
MEMORY_CONSOLIDATION_MAX_CHARS=6000
MEMORY_SUMMARY_MAX_CHARS=4000
MEMORY_SUMMARY_MAX_TOKENS=700
MEMORY_MAX_BATCHES_PER_REQUEST=3

# Hard context guard: input + reserved output + safety margin must fit the model window.
MODEL_CONTEXT_MAX_TOKENS=32768
MODEL_MAX_OUTPUT_TOKENS=1200
CONTEXT_SAFETY_TOKENS=1024

# Emotion JSON classification: disable model thinking, reserve enough output, retry empty JSON once.
EMOTION_MAX_OUTPUT_TOKENS=256
JSON_EMPTY_RESPONSE_RETRIES=1

# MySQL stores conversation history. Create this database before starting the app.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_toy
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_toy
MYSQL_CONNECT_TIMEOUT=5
